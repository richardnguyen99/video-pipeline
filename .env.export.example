# Copy to `.env.export` (do not commit secrets).
#   cp .env.export.example .env.export

# Source database (read-only export). Prefer a role with SELECT only.
# Either set DATABASE_URL, or the discrete fields below.
# DATABASE_URL=postgresql://export_user:secret@localhost:5432/javdb

PGHOST=localhost
PGPORT=5432
PGUSER=export_user
PGPASSWORD=change-me
PGDATABASE=javdb

# Optional: force schema search path
# PGOPTIONS=-c search_path=public,app_user_schema

# Where CSV batches are written
EXPORT_DIR=./exports

# Rows per file: <table_name>_<batch_num>.csv
BATCH_SIZE=10000

# Optional: only export these tables (space-separated physical names)
# EXPORT_TABLES="video actress comment"
