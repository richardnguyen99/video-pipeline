# Copy to `.env.import` (do not commit secrets).
#   cp .env.import.example .env.import

# Target database (isolated project DB).
# Either set DATABASE_URL, or the discrete fields below.
# DATABASE_URL=postgresql://video_pipeline:secret@localhost:5432/video_pipeline

PGHOST=localhost
PGPORT=5432
PGUSER=video_pipeline
PGPASSWORD=change-me
PGDATABASE=video_pipeline

# Directory containing <table_name>_<batch_num>.csv files
IMPORT_DIR=./exports

# Optional: TRUNCATE tables before import (CASCADE + RESTART IDENTITY).
# WARNING: this deletes existing rows (including newly uploaded videos).
# Default: false — import only inserts missing rows (ON CONFLICT DO NOTHING).
# TRUNCATE_BEFORE_IMPORT=true

# Optional: only import these physical table names (space-separated)
# IMPORT_TABLES="user actress video"

# Optional: conflict-safe import (default: true).
# - Preserves existing rows (never UPDATE in place).
# - video rows with the same business video_id as a live row are skipped.
# - video rows that only collide on numeric id are remapped; child tables
#   (images, samples, associations) rewrite fk_id/video_id to the new id so
#   relations do not attach to a newly uploaded local video.
# Set false only on an empty DB (plain COPY; fails on conflicts).
# ON_CONFLICT_SKIP=true
