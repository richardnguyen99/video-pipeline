# Copy to `.env.minio` and adjust. Keep `.env.minio` out of git.
#   cp .env.minio.example .env.minio

# MinIO server credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Absolute path on the EXTERNAL drive where MinIO stores object data.
# Example (change to your mount):
#   MINIO_DATA_DIR=
MINIO_DATA_DIR=/path/to/external-drive/minio-data

# Absolute path of existing HLS packages to migrate INTO MinIO.
# Expected layout: ${HLS_SOURCE_DIR}/<uuid>/index.m3u8
# Example:
HLS_SOURCE_DIR=/path/to/external-drive/hls

# Optional: bucket name used by migrate script (must match backend)
MINIO_BUCKET=video-samples
MINIO_ENDPOINT=http://localhost:9000
