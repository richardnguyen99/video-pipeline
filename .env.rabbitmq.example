# Copy to `.env.rabbitmq` (do not commit).
#   cp .env.rabbitmq.example .env.rabbitmq

RABBITMQ_USER=velvet
RABBITMQ_PASSWORD=change-me-strong-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# Optional: bind-mount on local filesystem instead of Docker named volume
# RABBITMQ_DATA_DIR=./data/rabbitmq
