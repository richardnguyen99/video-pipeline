{
  "editor.formatOnSave": true,

  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": false,
    "~/.claude/rules": false
  },
  "cSpell.words": [
    "appendfsync",
    "appendonly",
    "checkfirst",
    "commitlint",
    "docstrings",
    "dotenv",
    "everysec",
    "healthcheck",
    "ilike",
    "jancode",
    "ondelete",
    "onupdate",
    "pkey",
    "refcolumns",
    "sqlacodegen",
    "sqlalchemy",
    "sqltypes",
    "trgm",
    "uselist"
  ],

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "isort.args": ["--profile", "black"],
  "pylint.args": ["--rcfile=${workspaceFolder}/backend/.pylintrc"],

  "[csv]": {
    "editor.defaultFormatter": "mechatroner.rainbow-csv",
    "editor.wordWrap": "off"
  }
}
