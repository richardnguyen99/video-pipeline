# Copy this file to .env and fill in the values

# development | production | test
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT access token (HttpOnly cookie). Use a long random secret in production.
# Local development (APP_ENV=development):
#   - Secure is forced OFF so cookies work on http://localhost
#   - SameSite=lax (use the Vite /api proxy so the cookie is first-party)
# Production:
#   - Secure is forced ON
#   - Use JWT_COOKIE_SAMESITE=none only for true cross-site SPAs (HTTPS)
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=20160
JWT_REFRESH_ROTATION_GRACE_SECONDS=30
JWT_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_PATH=/
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_COOKIE_SAMESITE=lax

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/video_pipeline

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=something-secret

# RabbitMQ (watch pipeline)
# Keep these in sync with .env.rabbitmq when using docker-compose.rabbitmq.yml.
RABBITMQ_URL=amqp://velvet:something@localhost:5672/
RABBITMQ_WATCH_QUEUE=watch.events
RABBITMQ_ENABLED=true

# Watch pipeline
# > 0: one countable view per user/video within the cooldown window.
# = 0: disable cross-session cooldown and allow repeated attempts to count
#      (still at most once per playback session).
WATCH_COOLDOWN_SECONDS=1800
WATCH_ELIGIBLE_THRESHOLD_SECONDS=30
WATCH_HEARTBEAT_INTERVAL_SECONDS=10
WATCH_EVENTS_FLUSH_INTERVAL_SECONDS=1800
WATCH_EVENTS_OBJECT_PREFIX=watch-events

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Local development: MinIO (docker compose -f docker-compose.minio.yml up -d)
# Production: AWS S3 (or S3-compatible) + public/CDN base URL
#
# OBJECT_STORAGE_PROVIDER=minio|s3
# OBJECT_STORAGE_ENDPOINT — required for MinIO; leave empty for AWS S3
# OBJECT_STORAGE_PUBLIC_BASE_URL — URLs returned to API clients

# --- local MinIO (default) ---
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=video-samples
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/video-samples

# --- production example (AWS S3 + CloudFront) ---
# APP_ENV=production
# OBJECT_STORAGE_PROVIDER=s3
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=AKIA...
# OBJECT_STORAGE_SECRET_KEY=...
# OBJECT_STORAGE_BUCKET=video-pipeline-prod
# OBJECT_STORAGE_REGION=ap-northeast-1
# OBJECT_STORAGE_USE_SSL=true
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/video-samples

# Elasticsearch (optional video full-text search)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_VIDEOS=videos
ELASTICSEARCH_INDEX_ACTRESSES=actresses
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# Resend email (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Velvet <noreply@example.com>
# Webhook URL must be the full path (not tunnel root):
#   https://<public-host>/api/v1/email/webhook
# Dev Tunnels: set the forwarded port to Public / anonymous access,
# otherwise Resend gets HTTP 401 before FastAPI runs.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# RESEND_AUDIENCE_ID=

# Public SPA URL (used in email verification links)
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_RESEND_COOLDOWN_MINUTES=5
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_RESEND_COOLDOWN_MINUTES=5
