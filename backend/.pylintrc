[MAIN]
# Basename-only skips (directory / file names, not full paths).
ignore=
    alembic,
    .venv,
    venv,
    .env,
    __pycache__,
    .mypy_cache,
    .pytest_cache,
    .git,
    .tox,
    .eggs,
    dist,
    build,
    node_modules,
    tests
# Path regexes; match relative or absolute paths (VS Code passes absolute).
# Prefer unescaped "." for ignore-paths: pylint normalizes patterns via
# pathlib and escaped "\." often fails to match (see pylint#7094).
ignore-paths=
    ^alembic/,
    ^tests/,
    .venv,
    .*/.venv/,
    .*/.venv$,
    ^venv/,
    .*/venv/,
    .*/site-packages/,
    .*/__pycache__/,
    .*/.mypy_cache/,
    .*/.pytest_cache/,
    .*/.tox/,
    .*/.git/
ignore-patterns=
    ^alembic$,
    ^tests$,
    ^\.venv$,
    ^venv$,
    ^__pycache__$,
    ^\.mypy_cache$,
    ^\.pytest_cache$,
    ^\.git$,
    ^\.tox$
jobs=0

[MESSAGES CONTROL]
disable=
    C0114,
    C0115,
    C0116,
    R0903,
    R0913,
    W0511,
    C0301,
    import-error,
    no-member,
    too-few-public-methods,
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    redefined-outer-name

[FORMAT]
max-line-length=79
indent-string='    '

[BASIC]
good-names=id,db,i,j,k,ex,e,_

[DESIGN]
max-args=10
max-attributes=15
max-locals=20

[TYPECHECK]
ignored-modules=sqlmodel,sqlalchemy,fastapi,pydantic

[SIMILARITIES]
min-similarity-lines=20
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
ignore-signatures=yes
