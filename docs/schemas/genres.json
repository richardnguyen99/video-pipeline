{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "total",
        "limit",
        "offset",
        "items"
    ],
    "properties": {
        "total": {
            "type": "number",
            "description": "Total number of genres available"
        },
        "limit": {
            "type": "number",
            "description": "The maximum number of genres returned in the response"
        },
        "offset": {
            "type": "number",
            "description": "The offset of the first genre in the response"
        },
        "items": {
            "type": "array",
            "description": "List of genre items",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "dmmId"
                ],
                "description": "Genre item in the list response",
                "properties": {
                    "id": {
                        "type": "number",
                        "description": "The unique identifier for the genre"
                    },
                    "name": {
                        "type": "string",
                        "description": "Name of the genre depending on the `locale` query"
                    },
                    "ruby": {
                        "type": "string",
                        "description": "The ruby text of the genre"
                    },
                    "dmmId": {
                        "type": "string",
                        "description": "The DMM identifier for the genre"
                    }
                }
            }
        }
    }
}
