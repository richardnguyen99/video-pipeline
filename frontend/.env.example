# Leave unset in local dev so the browser uses same-origin `/api/v1`
# (Vite proxies to the backend). That keeps the access_token cookie first-party.
#
# Only set this for SSR or when the API is on another origin (then cookies need
# SameSite=None; Secure on HTTPS).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Vite proxy target (optional; default http://localhost:8000)
# VITE_BACKEND_ORIGIN=http://localhost:8000
