# Do NOT set VITE_API_BASE_URL for local browser use.
# The client always calls same-origin `/api/v1` (Vite proxies to the backend)
# so the HttpOnly access_token cookie remains first-party and is sent on
# every request (including GET /auth/me).
#
# Optional: absolute URL for SSR only (server has no browser cookies).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Vite proxy target (optional; default http://localhost:8000)
# VITE_BACKEND_ORIGIN=http://localhost:8000
